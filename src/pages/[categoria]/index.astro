---
import { categorias, productos } from '../../data/catalogo';

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return categorias.map((categoria) => ({ params: { categoria: categoria.slug } }));
}

const { categoria } = Astro.params;
const categoriaData = categorias.find((item) => item.slug === categoria);
const items = productos.filter((producto) => producto.categoria === categoria);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{categoriaData ? categoriaData.nombre : 'Categoría'} | CaterTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href={`${base}css/style.css`} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <div class="header__contact" aria-label="Información de contacto">
      <a class="header__contact-item" href="https://wa.me/573132416739" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
        <strong>Línea móvil y WhatsApp: 313 241 6739</strong>
      </a>
      <a class="header__contact-item" href="mailto:ventas7@catekomsas.com">
        <i class="fas fa-envelope" aria-hidden="true"></i>
        <strong>ventas7@catekomsas.com</strong>
      </a>
    </div>

    <header class="header">
      <div class="container">
        <nav class="navbar navbar-expand-lg align-items-center" aria-label="Navegación principal">
          <a class="navbar-brand header__logo" href={base} aria-label="CaterTrack inicio">
            <img src={`${base}assets/images/foot.webp`} alt="CaterTrack logo" class="header__logo-image" />
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Abrir menú">
            <span></span><span></span><span></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav header__menu">
              <li class="nav-item"><a class="nav-link" href={base}>Inicio</a></li>
              <li class="nav-item"><a class="nav-link" href="#">Novedades</a></li>
              <li class="nav-item"><a class="nav-link" href="#">Repuestos Maquinaria Pesada</a></li>
              <li class="nav-item"><a class="nav-link" href="#">Sucursales</a></li>
              <li class="nav-item"><a class="nav-link" href="#">Distribuciones</a></li>
              <li class="nav-item"><a class="nav-link" href="#">Nosotros</a></li>
              <li class="nav-item"><a class="nav-link" href="#">Contacto</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <nav class="catalog-navigation" aria-label="Categorías del catálogo">
      <div class="container">
        <ul>
          {categorias.map((item) => (
            <li>
              <a href={`${base}${item.slug}`} aria-current={item.slug === categoria ? 'page' : undefined}>{item.nombre}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <main id="main-content" aria-label="Catálogo de {categoriaData?.nombre ?? 'categoría'}">
      <section class="catalog-products">
        <div class="container">
          <div class="catalog-section-heading">
            <div>
              <span class="catalog-hero__eyebrow">Explora por componente</span>
              <h2>Encuentra el repuesto que necesitas</h2>
            </div>
            <span class="catalog-result">{items.length} productos disponibles</span>
          </div>

          <div class="subcategory-filters" aria-label="Filtrar por subcategoría">
            <button class="subcategory-filter is-active" type="button" data-filter="all">Todos</button>
            {categoriaData?.subcategorias.map((subcategoria) => (
              <button class="subcategory-filter" type="button" data-filter={subcategoria.slug}>{subcategoria.nombre}</button>
            ))}
          </div>

          <div class="product-grid">
            {items.map((producto) => (
              <article class="product-card" data-subcategory={producto.subcategoria}>
                <a href={`${base}${categoria}/${producto.subcategoria}/${producto.slug}`} class="product-card__visual" aria-label={`Ver ${producto.nombre}`}>
                  <img src={producto.foto || `${base}assets/images/products/placeholder.svg`} alt={producto.nombre} loading="lazy" />
                </a>
                <div class="product-card__content">
                  <span class="product-card__category">{producto.subcategoria}</span>
                  <span class="product-card__availability"><strong>Disponibilidad:</strong> {producto.disponibilidad ?? 'Por confirmar'}</span>
                  <h3>{producto.nombre}</h3>
                  <dl class="product-card__details">
                    <div><dt>Marca</dt><dd>{producto.marca}</dd></div>
                    <div><dt>Aplicación</dt><dd>{producto.aplicacion}</dd></div>
                  </dl>
                  <p class="product-card__description">{producto.descripcion}</p>
                  <a class="product-card__cta" href={`https://wa.me/573132416739?text=${encodeURIComponent(`Hola CaterTrack, quiero cotizar ${producto.nombre}`)}`} target="_blank" rel="noopener noreferrer">
                    Solicitar cotización
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="footer" id="footer">
      <div class="container footer-grid">
        <div class="footer-branding">
          <div class="footer__brand">
            <img src={`${base}assets/images/foot.webp`} alt="CaterTrack logo" class="footer__logo-image" />
          </div>
          <p>Especialistas en repuestos para maquinaria pesada, con soluciones rápidas y asesoría técnica especializada.</p>
        </div>

        <div class="footer-column">
          <h3>Contacto</h3>
          <ul>
            <li><a href="mailto:recursoshumanos@catekomsas.com"><i class="fa-regular fa-envelope"></i> recursoshumanos@catekomsas.com</a></li>
            <li><a href="mailto:compras@catekomsas.com"><i class="fa-regular fa-envelope"></i> compras@catekomsas.com</a></li>
            <li><a href="mailto:cartera@catekomsas.com"><i class="fa-regular fa-envelope"></i> cartera@catekomsas.com</a></li>
            <li><a href="mailto:ventas7@catekomsas.com"><i class="fa-regular fa-envelope"></i> ventas7@catekomsas.com</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h3>Redes</h3>
          <ul>
            <li><a href="#"><i class="fa-brands fa-linkedin-in"></i> LinkedIn</a></li>
            <li><a href="#"><i class="fa-brands fa-instagram"></i> Instagram</a></li>
            <li><a href="#"><i class="fa-brands fa-facebook-f"></i> Facebook</a></li>
            <li><a href="#"><i class="fa-brands fa-tiktok"></i> TikTok</a></li>
          </ul>
        </div>

        <div class="footer-column footer-column--cta">
          <h3>Trabaja con nosotros</h3>
          <p>¿Quieres formar parte de nuestro equipo?</p>
          <a href="#" class="footer__cta">Enviar hoja de vida</a>
        </div>
      </div>

      <div class="footer__bottom">
        <p>© 2026 CaterTrack. Todos los derechos reservados.</p>
      </div>
    </footer>

    <a class="back-to-top" href="#top" aria-label="Volver arriba"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></a>
    <a class="whatsapp-float" href="https://wa.me/573132416739" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const backToTopButton = document.querySelector('.back-to-top');
      const toggleBackToTop = () => {
        if (!backToTopButton) return;
        backToTopButton.classList.toggle('is-visible', window.scrollY > 220);
      };
      window.addEventListener('scroll', toggleBackToTop, { passive: true });
      toggleBackToTop();

      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.subcategory-filter');
      const productCards = document.querySelectorAll<HTMLElement>('.product-card');
      const resultCounter = document.querySelector<HTMLElement>('.catalog-result');

      const applyCategoryFilter = (filterValue: string) => {
        let visibleCount = 0;

        productCards.forEach((card) => {
          const matches = filterValue === 'all' || card.dataset.subcategory === filterValue;
          card.hidden = !matches;

          if (matches) {
            visibleCount += 1;
          }
        });

        if (resultCounter) {
          const label = visibleCount === 1 ? 'producto disponible' : 'productos disponibles';
          resultCounter.textContent = `${visibleCount} ${label}`;
        }
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const selectedFilter = button.dataset.filter || 'all';

          filterButtons.forEach((item) => {
            item.classList.toggle('is-active', item === button);
          });

          applyCategoryFilter(selectedFilter);
        });
      });

      applyCategoryFilter('all');
    </script>
  </body>
</html>
